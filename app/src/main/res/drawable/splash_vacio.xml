<?xml version="1.0" encoding="utf-8"?>
<!--
  Icono totalmente transparente.

  Desde Android 12 el sistema dibuja SIEMPRE una pantalla de arranque con el
  icono de la app antes del primer frame, y no se puede desactivar. Lo que si
  se puede es darle un icono invisible sobre fondo negro: entonces solo se ve
  negro, y enlaza sin corte con nuestro splash.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
