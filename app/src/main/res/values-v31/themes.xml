<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Android 12+ obliga a mostrar su propia pantalla de arranque con el icono
      de la app. No se puede quitar, pero si dejarla en negro puro con el
      icono invisible: asi el usuario solo ve negro hasta que entra nuestro
      splash, sin el salto del icono estatico.
    -->
    <style name="Theme.RoyerMethod" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_vacio</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>

</resources>
